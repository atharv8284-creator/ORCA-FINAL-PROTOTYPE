ENVIRONMENT=development
PROJECT_NAME="ORCA Marine Ecosystem Reasoning API"
API_V1_STR=/api/v1
PORT=8000
HOST=0.0.0.0
DEBUG=True

# PostgreSQL + PostGIS (Optional for local testing; backend automatically falls back to built-in spatial store if PostgreSQL is offline)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=orca_marine_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orca_marine_db

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Copernicus Data Space Ecosystem (CDSE)
# STAC Metadata Discovery is OPEN and does not require credentials:
COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1
COPERNICUS_AUTH_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token

# Optional: To download raw Sentinel raster granules and assets, register a free account
# at https://dataspace.copernicus.eu/ and configure OAuth2 credentials:
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# NUGEN Neural Inference Service (Server-side only)
# Keep empty until official Nugen API credentials, endpoint, and aligned model ID are supplied.
# When empty, Lead Orchestrator safely operates in HEURISTIC_RULE_BASED fallback mode.
NUGEN_API_KEY=
NUGEN_ENDPOINT=
NUGEN_MODEL_ID=
NUGEN_TIMEOUT_SECONDS=30.0

# Automatic Identification System (AIS) Vessel Tracking (Phase 4)
# Supported Providers: 'aishub', 'marinetraffic', or 'demo'
# If unconfigured, ORCA safely reports status: NOT CONNECTED without fabricating vessel data.
AIS_PROVIDER=aishub
AIS_API_KEY=
AIS_API_ENDPOINT=https://data.aishub.net/ws.php
AIS_CACHE_TTL_SECONDS=60
AIS_DEMO_MODE=false

# MarineTraffic API Adapter (used when AIS_PROVIDER=marinetraffic)
MARINETRAFFIC_API_KEY=
MARINETRAFFIC_API_ENDPOINT=https://services.marinetraffic.com/api/exportvessels/v:8

# Copernicus Marine Service (CMEMS - Phase 2)
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=
COPERNICUS_MARINE_API_KEY=

# In-Situ IoT Marine Buoy & Virtual ESP32 Intelligence (Phase 5)
IOT_INGESTION_KEY=orca-esp32-ingest-key-2026
IOT_SIMULATION_ENABLED=true
IOT_DEVICE_ID=ORCA-BUOY-001
IOT_UPDATE_INTERVAL_SECONDS=5
IOT_DEFAULT_SCENARIO=normal
IOT_ENABLE_REAL_DEVICE=false

