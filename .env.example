# Environment Configuration Example for ORCA
# Marine Ecosystem Reasoning with Collaborative Autonomous Agents
# Indradhanu Hackathon 2026: AI for Greener Tomorrow

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="ORCA - Marine Ecosystem Reasoning"
DEBUG=True
API_V1_STR=/api/v1
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL with PostGIS)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=orca_marine_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_here
DATABASE_URL=postgresql://postgres:postgres_password_here@localhost:5432/orca_marine_db

# Agent Swarm Configuration
AGENT_SWARM_MAX_CONCURRENCY=5
AGENT_REASONING_INTERVAL_SECONDS=10
SIMULATION_MODE=True

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Frontend Public API URL (used by React)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Copernicus Data Space Ecosystem (CDSE)
# STAC Metadata Discovery is OPEN and does not require credentials:
COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1
COPERNICUS_AUTH_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token

# Optional: To download raw Sentinel raster granules and assets, register a free account
# at https://dataspace.copernicus.eu/ and configure OAuth2 credentials:
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# Copernicus Marine Service (CMS / CMEMS - marine.copernicus.eu)
# STAC Catalog & OGC WMTS APIs are OPEN and queryable without authentication:
COPERNICUS_MARINE_STAC_URL=https://stac.marine.copernicus.eu/metadata/catalog.stac.json
COPERNICUS_MARINE_WMTS_URL=https://wmts.marine.copernicus.eu/teroWmts

# Optional: To use the official Copernicus Marine Toolbox (copernicusmarine) for large netCDF/Zarr downloads,
# register a free account at https://data.marine.copernicus.eu/ and configure credentials:
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=
COPERNICUS_MARINE_API_KEY=

# Automatic Identification System (AIS) Vessel Tracking
# Provider-independent architecture supporting AISHub, MarineTraffic, and custom providers.
# IMPORTANT: AISHub contributor registration is NOT mandatory. If credentials are not configured,
# the system safely reports "NOT CONNECTED" with zero synthetic mock data.
# A clearly-labeled demonstration mode can be activated via AIS_DEMO_MODE=True or in the UI.
AIS_PROVIDER=aishub # Options: aishub, marinetraffic, demo
AIS_API_KEY=
AIS_API_ENDPOINT=https://data.aishub.net/ws.php
AIS_CACHE_TTL_SECONDS=60
AIS_DEMO_MODE=False

# MarineTraffic API (Alternative provider, optional)
# Official documentation: https://www.marinetraffic.com/en/ais-api-services/documentation
MARINETRAFFIC_API_KEY=
MARINETRAFFIC_API_ENDPOINT=https://services.marinetraffic.com/api/exportvessels/v:8
